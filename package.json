{
  "name": "jjakkung",
  "private": true,
  "version": "0.1.0",
  "description": "화면 위 펫과 같이 일하는 데스크톱 앱",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist": "electron-vite build && electron-builder --publish never",
    "dist:mac": "electron-vite build && electron-builder --mac --publish never",
    "dist:win": "electron-vite build && electron-builder --win --publish never",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "node --test \"src/**/*.test.ts\"",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "onnxruntime-web": "1.30.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1",
    "typescript": "7.0.2",
    "vite": "7.3.6"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "koffi": "3.3.2",
    "node-llama-cpp": "3.22.1"
  }
}
