{
  "name": "jjakkung",
  "private": true,
  "version": "0.0.0",
  "description": "화면 위 펫과 같이 일하는 데스크톱 앱",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
