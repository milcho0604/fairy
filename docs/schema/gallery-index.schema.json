{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/milcho0604/fairy/blob/main/docs/schema/gallery-index.schema.json",
  "title": "fairy gallery index (gallery/index.json)",
  "description": "Generated by scripts/gallery-index.mjs. Do not edit by hand. At most 256 KiB and 300 pets.",
  "type": "object",
  "required": ["format", "version", "pets"],
  "properties": {
    "format": { "const": "jjakkung-gallery" },
    "version": { "const": 1 },
    "pets": {
      "type": "array",
      "maxItems": 300,
      "items": {
        "type": "object",
        "required": ["id", "name", "species", "author", "license", "created", "appVersion", "file", "size", "sha256", "thumbnail", "thumbSha256"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,38}[a-z0-9])?$" },
          "name": { "type": "string" },
          "species": { "enum": ["kong", "cat", "chick", "dog", "bunny"] },
          "author": { "type": "string", "maxLength": 40 },
          "license": { "enum": ["CC-BY-4.0", "CC-BY-SA-4.0", "CC-BY-NC-4.0", "CC0-1.0"] },
          "created": { "type": "string" },
          "appVersion": { "type": "string" },
          "file": { "type": "string", "description": "Always pets/<id>.jjpet" },
          "size": { "type": "integer", "minimum": 1, "maximum": 16777216 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "thumbnail": { "type": "string", "description": "Always thumbs/<id>.png" },
          "thumbSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
