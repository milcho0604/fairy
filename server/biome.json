{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "root": false,
  "extends": "//",
  "files": { "includes": ["src/**", "!src/shared", "test/**", "scripts/**", "*.json", "!package-lock.json"] },
  "linter": {
    "rules": {
      "preset": "recommended",
      "style": { "useImportType": "off" }
    }
  },
  "javascript": { "parser": { "unsafeParameterDecoratorsEnabled": true } }
}
