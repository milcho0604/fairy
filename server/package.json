{
  "name": "fairy-server",
  "private": true,
  "version": "0.0.0",
  "description": "페어리 서버: 계정, 서버 코인, AI 대화권, 운영자 이벤트 (docs/server-plan.md)",
  "license": "MIT",
  "type": "commonjs",
  "scripts": {
    "sync-shared": "node scripts/sync-shared.mjs",
    "build": "npm run sync-shared && tsc -p tsconfig.build.json",
    "typecheck": "npm run sync-shared && tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "migrate": "node scripts/migrate.mjs",
    "start": "node scripts/migrate.mjs && node dist/main.js",
    "test": "npm run sync-shared && tsc -p tsconfig.json && node --test \"dist-test/src/**/*.test.js\"",
    "test:integration": "npm run sync-shared && tsc -p tsconfig.json && node --test --test-concurrency=1 --test-timeout=180000 \"dist-test/test/**/*.test.js\"",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=26"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-express": "^11.2.8",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "overrides": {
    "body-parser": "^2.4.0",
    "multer": "^2.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "typescript": "^5.9.3"
  }
}
